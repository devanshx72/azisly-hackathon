# PlanetPulse Backend Environment Variables

# PostgreSQL database URL (e.g. from Supabase / Neon)
# Example: postgresql://postgres.[PROJECT_REF]:YOUR_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
# If left empty, the application falls back to a local sqlite database: sqlite:///./planetpulse.db
DATABASE_URL=

# Port to run on (defaults to 8000)
PORT=8000

# Allowed CORS origins (comma-separated, or * for all)
CORS_ORIGINS=*
